{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RocketsAreNostalgic/ran-booster-release-bootstrap-templates/blob/main/schema/template-pack.schema.json",
  "title": "RAN Booster release bootstrap template pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "consumer_api",
    "pack_version",
    "repository",
    "release",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "consumer_api": {
      "const": 3
    },
    "pack_version": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id"
      ],
      "properties": {
        "name": {
          "const": "RocketsAreNostalgic/ran-booster-release-bootstrap-templates"
        },
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "commit"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source-ready-wordpress-plugin/3",
        "source-ready-wordpress-theme/3"
      ],
      "properties": {
        "source-ready-wordpress-plugin/3": {
          "$ref": "#/$defs/profile"
        },
        "source-ready-wordpress-theme/3": {
          "$ref": "#/$defs/profile"
        }
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_version",
        "entries"
      ],
      "properties": {
        "profile_version": {
          "const": 1
        },
        "entries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quality-workflow",
            "release-workflow",
            "release-please-config",
            "build-release-script",
            "verify-release-script"
          ],
          "properties": {
            "quality-workflow": {
              "allOf": [
                {
                  "$ref": "#/$defs/entry"
                },
                {
                  "properties": {
                    "path": {
                      "const": "templates/shared/quality.yml.tmpl"
                    },
                    "placeholders": {
                      "const": {
                        "PACKAGE_SLUG": "slug",
                        "PHP_VERSION": "php_version"
                      }
                    }
                  }
                }
              ]
            },
            "release-workflow": {
              "allOf": [
                {
                  "$ref": "#/$defs/entry"
                },
                {
                  "properties": {
                    "path": {
                      "const": "templates/shared/release-please.yml.tmpl"
                    },
                    "placeholders": {
                      "const": {
                        "PACKAGE_SLUG": "slug"
                      }
                    }
                  }
                }
              ]
            },
            "release-please-config": {
              "allOf": [
                {
                  "$ref": "#/$defs/entry"
                },
                {
                  "properties": {
                    "path": {
                      "const": "templates/shared/release-please-config.json.tmpl"
                    },
                    "placeholders": {
                      "const": {
                        "BASE_SHA": "sha",
                        "EXTRA_FILES_JSON": "json_fragment",
                        "PACKAGE_SLUG": "slug"
                      }
                    }
                  }
                }
              ]
            },
            "build-release-script": {
              "allOf": [
                {
                  "$ref": "#/$defs/entry"
                },
                {
                  "properties": {
                    "path": {
                      "const": "templates/shared/build-release.sh.tmpl"
                    },
                    "placeholders": {
                      "const": {
                        "HEADER_PATH": "path",
                        "PACKAGE_SLUG": "slug",
                        "PACKAGE_TYPE": "package_type"
                      }
                    }
                  }
                }
              ]
            },
            "verify-release-script": {
              "allOf": [
                {
                  "$ref": "#/$defs/entry"
                },
                {
                  "properties": {
                    "path": {
                      "const": "templates/shared/verify-release.sh.tmpl"
                    },
                    "placeholders": {
                      "const": {
                        "HEADER_PATH": "path",
                        "PACKAGE_SLUG": "slug",
                        "PACKAGE_TYPE": "package_type",
                        "UPDATE_URI": "github_uri"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "sha256",
        "placeholders"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^templates/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
          "maxLength": 255
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "placeholders": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "branch",
              "github_uri",
              "json_fragment",
              "package_type",
              "path",
              "php_version",
              "sha",
              "slug"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    }
  }
}
