#!/usr/bin/env bash
set -euo pipefail

fail() {
	printf 'verify-release: %s\n' "$*" >&2
	exit 1
}

project_root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
slug='{{RAN_PACKAGE_SLUG}}'
package_kind='{{RAN_PACKAGE_TYPE}}'
header_file='{{RAN_HEADER_PATH}}'
update_uri='{{RAN_UPDATE_URI}}'
archive=${1:-}
expected_version=${2:-}
release_ref=${3:-}

[[ -f "$archive" && ! -L "$archive" ]] || fail 'release ZIP is missing or symbolic.'
[[ "$package_kind" == plugin || "$package_kind" == theme ]] || fail 'package kind is invalid.'
[[ "$header_file" =~ ^[A-Za-z0-9._/-]+$ && "$header_file" != /* && "$header_file" != *'..'* ]] \
	|| fail 'header path is invalid.'
[[ "$expected_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] \
	|| fail 'expected version is invalid.'
[[ -n "$release_ref" ]] || fail 'expected an explicit release commit.'
commit=$(git -C "$project_root" rev-parse --verify "$release_ref^{commit}") \
	|| fail 'release ref does not resolve to a commit.'
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || fail 'release commit is invalid.'

regular_blob_oid() {
	local file=$1 record metadata listed mode type object extra
	record=$(git -C "$project_root" ls-tree --full-tree "$commit" -- "$file") \
		|| fail "could not inspect committed source: $file"
	[[ -n "$record" && "$record" == *$'\t'* ]] \
		|| fail "committed source is missing: $file"
	metadata=${record%%$'\t'*}
	listed=${record#*$'\t'}
	read -r mode type object extra <<< "$metadata"
	[[ "$listed" == "$file" && -z "${extra:-}" && "$type" == blob \
		&& ( "$mode" == 100644 || "$mode" == 100755 ) \
		&& "$object" =~ ^[0-9a-f]{40,64}$ ]] \
		|| fail "committed source is not one regular blob: $file"
	printf '%s\n' "$object"
}

actual=$(mktemp)
expected=$(mktemp)
temporary=$(mktemp -d "${TMPDIR:-/tmp}/${slug}-verify.XXXXXX")
allowlist="$temporary/release-contents.txt"
projection="$temporary/projection.tsv"
trap 'rm -f "$actual" "$expected"; rm -rf "$temporary"' EXIT HUP INT TERM
: > "$projection"

node --input-type=module - "$archive" > "$actual" <<'RAN_ARCHIVE_INSPECTOR'
import { readFileSync, statSync } from "node:fs";
import { inflateRawSync } from "node:zlib";

const limits = {
  archiveBytes: 50 * 1024 * 1024,
  members: 10000,
  memberBytes: 127826407,
  totalBytes: 127826407,
  ratio: 200,
};
const crcTable = buildCrcTable();

try {
  const archive = process.argv[2];
  const size = statSync(archive).size;
  if (size === 0 || size > limits.archiveBytes) invalid("archive_size");
  const bytes = readFileSync(archive);
  const eocd = findEocd(bytes);
  if (
    eocd < 0 ||
    bytes.readUInt16LE(eocd + 20) !== 0 ||
    eocd + 22 !== bytes.length
  )
    invalid("directory_missing");
  const disk = bytes.readUInt16LE(eocd + 4);
  const centralDisk = bytes.readUInt16LE(eocd + 6);
  const diskEntries = bytes.readUInt16LE(eocd + 8);
  const entryCount = bytes.readUInt16LE(eocd + 10);
  const centralSize = bytes.readUInt32LE(eocd + 12);
  const centralOffset = bytes.readUInt32LE(eocd + 16);
  if (
    disk !== 0 ||
    centralDisk !== 0 ||
    diskEntries !== entryCount ||
    entryCount === 0xffff ||
    centralSize === 0xffffffff ||
    centralOffset === 0xffffffff
  )
    invalid("multidisk_or_zip64");
  if (
    entryCount === 0 ||
    entryCount > limits.members ||
    centralOffset + centralSize !== eocd
  )
    invalid("directory_bounds");

  const entries = [];
  const rawNames = new Set();
  const logicalNames = new Map();
  let offset = centralOffset;
  let totalBytes = 0;
  for (let index = 0; index < entryCount; index += 1) {
    if (offset + 46 > eocd || bytes.readUInt32LE(offset) !== 0x02014b50)
      invalid("directory_record");
    const madeBy = bytes.readUInt16LE(offset + 4);
    const needed = bytes.readUInt16LE(offset + 6);
    const flags = bytes.readUInt16LE(offset + 8);
    const method = bytes.readUInt16LE(offset + 10);
    const crc = bytes.readUInt32LE(offset + 16);
    const compressedSize = bytes.readUInt32LE(offset + 20);
    const uncompressedSize = bytes.readUInt32LE(offset + 24);
    const nameLength = bytes.readUInt16LE(offset + 28);
    const extraLength = bytes.readUInt16LE(offset + 30);
    const commentLength = bytes.readUInt16LE(offset + 32);
    const diskStart = bytes.readUInt16LE(offset + 34);
    const attributes = bytes.readUInt32LE(offset + 38);
    const localOffset = bytes.readUInt32LE(offset + 42);
    const next = offset + 46 + nameLength + extraLength + commentLength;
    if (
      needed >= 45 ||
      nameLength === 0 ||
      extraLength !== 0 ||
      commentLength !== 0 ||
      diskStart !== 0 ||
      compressedSize === 0xffffffff ||
      uncompressedSize === 0xffffffff ||
      localOffset === 0xffffffff ||
      next > eocd
    )
      invalid("directory_record");
    const name = decodeName(bytes.subarray(offset + 46, offset + 46 + nameLength));
    const directory = name.endsWith("/");
    validateName(name);
    if (rawNames.has(name)) invalid("duplicate_member");
    rawNames.add(name);
    const logical = name.slice(0, directory ? -1 : undefined).toLowerCase();
    if (logicalNames.has(logical)) invalid("normalized_collision");
    logicalNames.set(logical, directory ? "directory" : "file");
    validateType(madeBy, attributes, directory);
    if ((flags & ~0x0800) !== 0 || ![0, 8].includes(method))
      invalid("unsupported_member");
    if (
      uncompressedSize > limits.memberBytes ||
      compressedSize > limits.archiveBytes ||
      (compressedSize === 0
        ? uncompressedSize > 0
        : uncompressedSize / compressedSize > limits.ratio)
    )
      invalid("member_budget");
    if (directory && (compressedSize !== 0 || uncompressedSize !== 0))
      invalid("directory_payload");
    totalBytes += uncompressedSize;
    if (totalBytes > limits.totalBytes) invalid("total_budget");
    entries.push({
      name,
      directory,
      flags,
      method,
      crc,
      compressedSize,
      uncompressedSize,
      localOffset,
    });
    offset = next;
  }
  if (offset !== eocd) invalid("directory_size");
  validateHierarchy(logicalNames);
  validateLocalRecords(bytes, entries, centralOffset);
  for (const entry of entries)
    process.stdout.write(`${entry.directory ? "D" : "F"}\t${entry.name}\n`);
} catch (error) {
  process.stderr.write(`verify-release archive: ${error?.code ?? "archive_invalid"}\n`);
  process.exit(1);
}

function validateLocalRecords(bytes, entries, centralOffset) {
  const ordered = [...entries].sort((left, right) => left.localOffset - right.localOffset);
  let expectedOffset = 0;
  for (const entry of ordered) {
    const offset = entry.localOffset;
    if (offset !== expectedOffset || offset + 30 > centralOffset)
      invalid("local_bounds");
    if (bytes.readUInt32LE(offset) !== 0x04034b50) invalid("local_header");
    const needed = bytes.readUInt16LE(offset + 4);
    const flags = bytes.readUInt16LE(offset + 6);
    const method = bytes.readUInt16LE(offset + 8);
    const crc = bytes.readUInt32LE(offset + 14);
    const compressedSize = bytes.readUInt32LE(offset + 18);
    const uncompressedSize = bytes.readUInt32LE(offset + 22);
    const nameLength = bytes.readUInt16LE(offset + 26);
    const extraLength = bytes.readUInt16LE(offset + 28);
    const nameStart = offset + 30;
    const dataStart = nameStart + nameLength + extraLength;
    const dataEnd = dataStart + compressedSize;
    if (
      needed >= 45 ||
      extraLength !== 0 ||
      flags !== entry.flags ||
      method !== entry.method ||
      crc !== entry.crc ||
      compressedSize !== entry.compressedSize ||
      uncompressedSize !== entry.uncompressedSize ||
      dataEnd > centralOffset ||
      decodeName(bytes.subarray(nameStart, nameStart + nameLength)) !== entry.name
    )
      invalid("local_mismatch");
    const compressed = bytes.subarray(dataStart, dataEnd);
    let output;
    try {
      output =
        method === 0
          ? Buffer.from(compressed)
          : inflateRawSync(compressed, { maxOutputLength: limits.memberBytes });
    } catch {
      invalid("member_decompression");
    }
    if (output.length !== uncompressedSize || crc32(output) !== crc)
      invalid("member_integrity");
    expectedOffset = dataEnd;
  }
  if (expectedOffset !== centralOffset) invalid("local_layout");
}

function validateName(name) {
  if (
    name !== name.normalize("NFC") ||
    name.length > 4096 ||
    !/^[A-Za-z0-9._/-]+$/.test(name) ||
    name.startsWith("/") ||
    /^[A-Za-z]:/.test(name) ||
    name.includes("\\") ||
    name.includes("\0")
  )
    invalid("member_path");
  const path = name.endsWith("/") ? name.slice(0, -1) : name;
  const parts = path.split("/");
  if (
    path === "" ||
    parts.some(
      (part) =>
        part === "" ||
        part === "." ||
        part === ".." ||
        part.length > 255 ||
        part.endsWith(".") ||
        /^(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\.|$)/i.test(part),
    )
  )
    invalid("member_path");
}

function validateHierarchy(names) {
  for (const [name] of names) {
    const parts = name.split("/");
    for (let index = 1; index < parts.length; index += 1)
      if (names.get(parts.slice(0, index).join("/")) === "file")
        invalid("member_hierarchy");
  }
}

function validateType(madeBy, attributes, directory) {
  const host = madeBy >>> 8;
  const mode = attributes >>> 16;
  const type = mode & 0o170000;
  const dosDirectory = (attributes & 0x10) !== 0;
  if (host !== 3 || directory !== dosDirectory) invalid("member_type");
  if (directory ? type !== 0o040000 : type !== 0o100000)
    invalid("member_type");
  if (!directory && (mode & 0o111) !== 0) invalid("member_executable");
}

function decodeName(bytes) {
  const name = bytes.toString("utf8");
  if (!Buffer.from(name, "utf8").equals(bytes)) invalid("name_encoding");
  return name;
}

function findEocd(bytes) {
  const minimum = Math.max(0, bytes.length - 65_557);
  for (let offset = bytes.length - 22; offset >= minimum; offset -= 1)
    if (bytes.readUInt32LE(offset) === 0x06054b50) return offset;
  return -1;
}

function buildCrcTable() {
  return Array.from({ length: 256 }, (_, value) => {
    let crc = value;
    for (let bit = 0; bit < 8; bit += 1)
      crc = (crc & 1) !== 0 ? 0xedb88320 ^ (crc >>> 1) : crc >>> 1;
    return crc >>> 0;
  });
}

function crc32(bytes) {
  let crc = 0xffffffff;
  for (const byte of bytes) crc = crcTable[(crc ^ byte) & 0xff] ^ (crc >>> 8);
  return (crc ^ 0xffffffff) >>> 0;
}

function invalid(code) {
  throw Object.assign(new Error(code), { code });
}
RAN_ARCHIVE_INSPECTOR

allowlist_oid=$(regular_blob_oid release-contents.txt)
git -C "$project_root" cat-file blob "$allowlist_oid" > "$allowlist"
[[ -s "$allowlist" ]] || fail 'release allowlist is empty.'

declare -A declared=()
declare -A projected=()
while IFS= read -r entry || [[ -n "$entry" ]]; do
	[[ -z "$entry" || "$entry" == \#* ]] && continue
	[[ "$entry" =~ ^[A-Za-z0-9._/-]+$ && "$entry" != /* && "$entry" != *'..'* ]] \
		|| fail "release allowlist entry is unsafe: $entry"
	entry=${entry%/}
	[[ -n "$entry" && -z "${declared[$entry]+x}" ]] \
		|| fail "duplicate release allowlist entry: $entry"
	declared[$entry]=1

	found=0
	while IFS= read -r -d '' record; do
		metadata=${record%%$'\t'*}
		path=${record#*$'\t'}
		read -r mode type object extra <<< "$metadata"
		[[ "$path" == "$entry" || "$path" == "$entry/"* ]] \
			|| fail "committed source escaped its allowlist entry: $path"
		[[ "$path" =~ ^[A-Za-z0-9._/-]+$ && "$path" != /* && "$path" != *'..'* ]] \
			|| fail "committed source path is unsafe: $path"
		[[ -z "${extra:-}" && "$type" == blob \
			&& ( "$mode" == 100644 || "$mode" == 100755 ) \
			&& "$object" =~ ^[0-9a-f]{40,64}$ ]] \
			|| fail "committed source is not a regular blob: $path"
		[[ -z "${projected[$path]+x}" ]] \
			|| fail "release allowlist projects a duplicate path: $path"
		projected[$path]=1
		printf '%s\t%s\n' "$path" "$object" >> "$projection"
		found=$((found + 1))
	done < <(git -C "$project_root" ls-tree -r -z --full-tree "$commit" -- "$entry")
	[[ "$found" -gt 0 ]] || fail "release allowlist entry is missing or empty: $entry"
done < "$allowlist"
[[ ${#declared[@]} -gt 0 && ${#projected[@]} -gt 0 ]] || fail 'release allowlist is empty.'

printf 'D\t%s/\n' "$slug" > "$expected"
while IFS=$'\t' read -r file object; do
	printf 'F\t%s/%s\n' "$slug" "$file" >> "$expected"
	parent=${file%/*}
	while [[ "$parent" != "$file" ]]; do
		printf 'D\t%s/%s/\n' "$slug" "$parent" >> "$expected"
		[[ "$parent" == */* ]] || break
		parent=${parent%/*}
	done
done < <(LC_ALL=C sort -t $'\t' -k1,1 "$projection")
LC_ALL=C sort -u -o "$expected" "$expected"
LC_ALL=C sort -o "$actual" "$actual"
diff -u "$expected" "$actual" || fail 'release ZIP differs from the committed runtime allowlist.'

unzip -tqq "$archive" >/dev/null || fail 'release ZIP is corrupt.'
unzip -q "$archive" -d "$temporary/extracted"
while IFS=$'\t' read -r file object; do
	git -C "$project_root" cat-file blob "$object" \
		| cmp -s - "$temporary/extracted/$slug/$file" \
		|| fail "release file differs from the release commit: $file"
done < <(LC_ALL=C sort -t $'\t' -k1,1 "$projection")

header="$temporary/extracted/$slug/$header_file"
[[ -f "$header" ]] || fail 'WordPress header file is absent from the release.'
header_version=$(sed -nE 's/^[[:space:]]*(\*)?[[:space:]]*Version:[[:space:]]*([^[:space:]]+).*/\2/p' "$header")
[[ "$header_version" == "$expected_version" ]] \
	|| fail 'archived WordPress header version is incorrect.'
if [[ "$package_kind" == plugin ]]; then
	grep -Eq '^[[:space:]]*\*[[:space:]]*Plugin Name:[[:space:]]*[^[:space:]]' "$header" \
		|| fail 'plugin name header is missing.'
else
	grep -Eq '^[[:space:]]*Theme Name:[[:space:]]*[^[:space:]]' "$header" \
		|| fail 'theme name header is missing.'
fi
grep -Fq "Update URI: $update_uri" "$header" \
	|| fail 'canonical Update URI is missing.'

version_oid=$(regular_blob_oid version.txt)
manifest_oid=$(regular_blob_oid .release-please-manifest.json)
version_source=$(git -C "$project_root" cat-file blob "$version_oid" | tr -d '[:space:]')
manifest_version=$(git -C "$project_root" cat-file blob "$manifest_oid" \
	| node -e 'let input=""; process.stdin.on("data", chunk => input += chunk); process.stdin.on("end", () => process.stdout.write(JSON.parse(input)["."] || ""));')
[[ "$version_source" == "$expected_version" && "$manifest_version" == "$expected_version" ]] \
	|| fail 'release commit version sources do not agree.'

archive_size=$(wc -c < "$archive" | tr -d '[:space:]')
archive_sha256=$(shasum -a 256 "$archive" | awk '{ print $1 }')
[[ "$archive_size" =~ ^[1-9][0-9]*$ && "$archive_sha256" =~ ^[0-9a-f]{64}$ ]] \
	|| fail 'release ZIP size or digest is invalid.'
printf 'Verified %s\nSHA-256 %s\n' "$archive" "$archive_sha256"
