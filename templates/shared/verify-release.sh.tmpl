#!/usr/bin/env bash
set -euo pipefail
export TZ=UTC LC_ALL=C

fail() {
	printf 'verify-release: %s\n' "$*" >&2
	exit 1
}

project_root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
slug='{{RAN_PACKAGE_SLUG}}'
package_kind='{{RAN_PACKAGE_TYPE}}'
header_file='{{RAN_HEADER_PATH}}'
update_uri='{{RAN_UPDATE_URI}}'
archive=${1:-}
expected_version=${2:-}
release_ref=${3:-}

[[ -f "$archive" && ! -L "$archive" ]] || fail 'release ZIP is missing or symbolic.'
[[ "$package_kind" == plugin || "$package_kind" == theme ]] || fail 'package kind is invalid.'
[[ "$header_file" =~ ^[A-Za-z0-9._-]+$ && "$header_file" != /* && "$header_file" != *'..'* ]] \
	|| fail 'header path is invalid.'
[[ "$expected_version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] \
	|| fail 'expected version is invalid.'
[[ -n "$release_ref" ]] || fail 'expected an explicit release commit.'
[[ "$slug" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ && "${#slug}" -le 100 ]] || fail 'package slug is invalid.'
[[ "${#expected_version}" -le 63 && "${#slug}" -le 100 ]] || fail 'identity length exceeds the starter bounds.'
[[ "$release_ref" =~ ^[0-9a-f]{40}$ ]] || fail 'expected an exact source commit.'

commit=$(git -C "$project_root" rev-parse --verify "$release_ref^{commit}") \
	|| fail 'release ref does not resolve to a commit.'
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || fail 'release commit is invalid.'

regular_blob_oid() {
	local file=$1 record metadata listed mode type object extra
	record=$(git -C "$project_root" ls-tree --full-tree "$commit" -- "$file") \
		|| fail "could not inspect committed source: $file"
	[[ -n "$record" && "$record" == *$'\t'* ]] \
		|| fail "committed source is missing: $file"
	metadata=${record%%$'\t'*}
	listed=${record#*$'\t'}
	read -r mode type object extra <<< "$metadata"
	[[ "$listed" == "$file" && -z "${extra:-}" && "$type" == blob \
		&& ( "$mode" == 100644 || "$mode" == 100755 ) \
		&& "$object" =~ ^[0-9a-f]{40,64}$ ]] \
		|| fail "committed source is not one regular blob: $file"
	printf '%s\n' "$object"
}

actual=$(mktemp)
expected=$(mktemp)
temporary=$(mktemp -d "${TMPDIR:-/tmp}/${slug}-verify.XXXXXX")
allowlist="$temporary/release-contents.txt"
projection="$temporary/projection.tsv"
trap 'rm -f "$actual" "$expected"; rm -rf "$temporary"' EXIT HUP INT TERM
: > "$projection"

RAN_ARCHIVE_PATH="$archive" php -d memory_limit=512M > "$actual" <<'RAN_ARCHIVE_INSPECTOR'
<?php
// Same bounded central/local ZIP checks as the original inspector, using the
// PHP runtime already selected by Quality. Never load or execute payload PHP.
function invalid($code) { throw new RuntimeException($code); }
function u16($b, $o) { if ($o + 2 > strlen($b)) invalid('directory_bounds'); return unpack('v', substr($b, $o, 2))[1]; }
function u32($b, $o) { if ($o + 4 > strlen($b)) invalid('directory_bounds'); return unpack('V', substr($b, $o, 4))[1]; }
function nameOf($name) {
    if (!preg_match('//u', $name)) invalid('name_encoding');
    return $name;
}
function validateName($name) {
    if (strlen($name) > 4096 || !preg_match('~^[A-Za-z0-9._/-]+$~D', $name) || $name[0] === '/') invalid('member_path');
    $path = substr($name, -1) === '/' ? substr($name, 0, -1) : $name;
    foreach (explode('/', $path) as $part) {
        if ($part === '' || $part === '.' || $part === '..' || strlen($part) > 255 || substr($part, -1) === '.' || preg_match('/^(con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\.|$)/i', $part)) invalid('member_path');
    }
}
try {
    $archive = getenv('RAN_ARCHIVE_PATH');
    $size = filesize($archive);
    if (!$size || $size > 50 * 1024 * 1024) invalid('archive_size');
    $bytes = file_get_contents($archive);
    $eocd = -1;
    for ($i = strlen($bytes) - 22; $i >= max(0, strlen($bytes) - 65557); $i--) {
        if (u32($bytes, $i) === 0x06054b50) { $eocd = $i; break; }
    }
    if ($eocd < 0 || u16($bytes, $eocd + 20) !== 0 || $eocd + 22 !== strlen($bytes)) invalid('directory_missing');
    $count = u16($bytes, $eocd + 10);
    $centralSize = u32($bytes, $eocd + 12);
    $central = u32($bytes, $eocd + 16);
    if (u16($bytes, $eocd + 4) !== 0 || u16($bytes, $eocd + 6) !== 0 || u16($bytes, $eocd + 8) !== $count || $count === 65535 || $centralSize === 0xffffffff || $central === 0xffffffff) invalid('multidisk_or_zip64');
    if ($count === 0 || $count > 10000 || $central + $centralSize !== $eocd) invalid('directory_bounds');
    $entries = []; $raw = []; $names = []; $offset = $central; $total = 0;
    for ($i = 0; $i < $count; $i++) {
        if ($offset + 46 > $eocd || u32($bytes, $offset) !== 0x02014b50) invalid('directory_record');
        $madeBy = u16($bytes, $offset + 4); $needed = u16($bytes, $offset + 6);
        $flags = u16($bytes, $offset + 8); $method = u16($bytes, $offset + 10);
        $crc = u32($bytes, $offset + 16); $compressed = u32($bytes, $offset + 20); $expanded = u32($bytes, $offset + 24);
        $nameLength = u16($bytes, $offset + 28); $extra = u16($bytes, $offset + 30); $comment = u16($bytes, $offset + 32);
        $attributes = u32($bytes, $offset + 38); $local = u32($bytes, $offset + 42);
        $next = $offset + 46 + $nameLength + $extra + $comment;
        if ($needed >= 45 || !$nameLength || $extra || $comment || u16($bytes, $offset + 34) || $compressed === 0xffffffff || $expanded === 0xffffffff || $local === 0xffffffff || $next > $eocd) invalid('directory_record');
        $name = nameOf(substr($bytes, $offset + 46, $nameLength));
        validateName($name); $directory = substr($name, -1) === '/';
        if (isset($raw[$name])) invalid('duplicate_member');
        $raw[$name] = true;
        $logical = strtolower($directory ? substr($name, 0, -1) : $name);
        if (isset($names[$logical])) invalid('normalized_collision');
        $names[$logical] = $directory ? 'directory' : 'file';
        $mode = $attributes >> 16; $type = $mode & 0170000;
        if (($madeBy >> 8) !== 3 || $directory !== (($attributes & 0x10) !== 0) || ($directory ? $type !== 0040000 : $type !== 0100000)) invalid('member_type');
        if (!$directory && ($mode & 0111)) invalid('member_executable');
        if (($flags & ~0x0800) || !in_array($method, [0, 8], true)) invalid('unsupported_member');
        if ($expanded > 127826407 || $compressed > 50 * 1024 * 1024 || ($compressed === 0 ? $expanded > 0 : $expanded / $compressed > 200)) invalid('member_budget');
        if ($directory && ($compressed || $expanded)) invalid('directory_payload');
        $total += $expanded; if ($total > 127826407) invalid('total_budget');
        $entries[] = compact('name', 'directory', 'flags', 'method', 'crc', 'compressed', 'expanded', 'local');
        $offset = $next;
    }
    if ($offset !== $eocd) invalid('directory_size');
    foreach ($names as $name => $type) {
        $parts = explode('/', $name);
        for ($i = 1; $i < count($parts); $i++) if (($names[implode('/', array_slice($parts, 0, $i))] ?? null) === 'file') invalid('member_hierarchy');
    }
    usort($entries, function ($a, $b) { return $a['local'] <=> $b['local']; });
    $expected = 0;
    foreach ($entries as $entry) {
        $offset = $entry['local'];
        if ($offset !== $expected || $offset + 30 > $central) invalid('local_bounds');
        if (u32($bytes, $offset) !== 0x04034b50) invalid('local_header');
        $nameLength = u16($bytes, $offset + 26); $extra = u16($bytes, $offset + 28);
        $start = $offset + 30 + $nameLength + $extra; $end = $start + $entry['compressed'];
        if (u16($bytes, $offset + 4) >= 45 || $extra || u16($bytes, $offset + 6) !== $entry['flags'] || u16($bytes, $offset + 8) !== $entry['method'] || u32($bytes, $offset + 14) !== $entry['crc'] || u32($bytes, $offset + 18) !== $entry['compressed'] || u32($bytes, $offset + 22) !== $entry['expanded'] || $end > $central || nameOf(substr($bytes, $offset + 30, $nameLength)) !== $entry['name']) invalid('local_mismatch');
        $payload = substr($bytes, $start, $entry['compressed']);
        $output = $entry['method'] === 0 ? $payload : @gzinflate($payload, max(1, $entry['expanded']));
        if ($output === false) invalid('member_decompression');
        if (strlen($output) !== $entry['expanded'] || crc32($output) !== $entry['crc']) invalid('member_integrity');
        $expected = $end;
    }
    if ($expected !== $central) invalid('local_layout');
    foreach ($entries as $entry) echo ($entry['directory'] ? 'D' : 'F') . "\t" . $entry['name'] . "\n";
} catch (Throwable $error) {
    fwrite(STDERR, 'verify-release archive: ' . $error->getMessage() . "\n"); exit(1);
}

RAN_ARCHIVE_INSPECTOR

allowlist_oid=$(regular_blob_oid release-contents.txt)
git -C "$project_root" cat-file blob "$allowlist_oid" > "$allowlist"
[[ -s "$allowlist" ]] || fail 'release allowlist is empty.'

declare -A projected=()
previous=''
while IFS= read -r entry || [[ -n "$entry" ]]; do
	[[ "$entry" =~ ^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$ && "$entry" != *'..'* ]] \
		|| fail "release allowlist entry is unsafe: $entry"
	[[ -z "$previous" || "$previous" < "$entry" ]] || fail 'allowlist must contain sorted unique explicit files.'
	previous=$entry
	object=$(regular_blob_oid "$entry")
	projected[$entry]=1
	printf '%s\t%s\n' "$entry" "$object" >> "$projection"
done < "$allowlist"
[[ ${#projected[@]} -gt 0 ]] || fail 'release allowlist is empty.'

if [[ "$package_kind" == theme ]]; then
	[[ -n "${projected[index.php]+x}" || -n "${projected[templates/index.html]+x}" ]] \
		|| fail 'theme requires an allowlisted index.php or templates/index.html.'
fi

printf 'D\t%s/\n' "$slug" > "$expected"
while IFS=$'\t' read -r file object; do
	printf 'F\t%s/%s\n' "$slug" "$file" >> "$expected"
	parent=${file%/*}
	while [[ "$parent" != "$file" ]]; do
		printf 'D\t%s/%s/\n' "$slug" "$parent" >> "$expected"
		[[ "$parent" == */* ]] || break
		parent=${parent%/*}
	done
done < <(LC_ALL=C sort -t $'\t' -k1,1 "$projection")
LC_ALL=C sort -u -o "$expected" "$expected"
LC_ALL=C sort -o "$actual" "$actual"
diff -u "$expected" "$actual" || fail 'release ZIP differs from the committed runtime allowlist.'

unzip -tqq "$archive" >/dev/null || fail 'release ZIP is corrupt.'
unzip -q "$archive" -d "$temporary/extracted"
while IFS=$'\t' read -r file object; do
	if head -n 1 "$temporary/extracted/$slug/$file" | grep -Fxq 'version https://git-lfs.github.com/spec/v1'; then
		fail "unresolved LFS pointer: $file"
	fi
	git -C "$project_root" cat-file blob "$object" \
		| cmp -s - "$temporary/extracted/$slug/$file" \
		|| fail "release file differs from the release commit: $file"
done < <(LC_ALL=C sort -t $'\t' -k1,1 "$projection")

header="$temporary/extracted/$slug/$header_file"
[[ -f "$header" ]] || fail 'WordPress header file is absent from the release.'
php_version=$(sed -nE 's/^[[:space:]]*(\*)?[[:space:]]*Requires PHP:[[:space:]]*([^[:space:]]+).*/\2/p' "$header")
[[ "$php_version" =~ ^(7\.4|8\.[0-5])$ ]] || fail 'Requires PHP is outside the reviewed starter set.'
wp_version=$(sed -nE 's/^[[:space:]]*(\*)?[[:space:]]*Requires at least:[[:space:]]*([^[:space:]]+).*/\2/p' "$header")
[[ "$wp_version" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]] || fail 'Requires at least header is missing or invalid.'
header_version=$(sed -nE 's/^[[:space:]]*(\*)?[[:space:]]*Version:[[:space:]]*([^[:space:]]+).*/\2/p' "$header")
[[ "$header_version" == "$expected_version" ]] \
	|| fail 'archived WordPress header version is incorrect.'
if [[ "$package_kind" == plugin ]]; then
	grep -Eq '^[[:space:]]*\*[[:space:]]*Plugin Name:[[:space:]]*[^[:space:]]' "$header" \
		|| fail 'plugin name header is missing.'
else
	grep -Eq '^[[:space:]]*Theme Name:[[:space:]]*[^[:space:]]' "$header" \
		|| fail 'theme name header is missing.'
fi
actual_uri=$(sed -nE 's/^[[:space:]]*(\*)?[[:space:]]*Update URI:[[:space:]]*([^[:space:]]+)[[:space:]]*$/\2/p' "$header")
[[ "$actual_uri" == "$update_uri" ]] || fail 'canonical Update URI is missing or differs.'

version_oid=$(regular_blob_oid version.txt)
manifest_oid=$(regular_blob_oid .release-please-manifest.json)
version_source=$(git -C "$project_root" cat-file blob "$version_oid" | tr -d '[:space:]')
manifest_version=$(git -C "$project_root" cat-file blob "$manifest_oid" \
	| jq -er 'select(type == "object" and keys == ["."]) | .["."] | select(type == "string")' )
[[ "$version_source" == "$expected_version" && "$manifest_version" == "$expected_version" ]] \
	|| fail 'release commit version sources do not agree.'

archive_size=$(wc -c < "$archive" | tr -d '[:space:]')
archive_sha256=$(shasum -a 256 "$archive" | awk '{ print $1 }')
[[ "$archive_size" =~ ^[1-9][0-9]*$ && "$archive_sha256" =~ ^[0-9a-f]{64}$ ]] \
	|| fail 'release ZIP size or digest is invalid.'
printf 'Verified %s\nSHA-256 %s\n' "$archive" "$archive_sha256"
