#!/usr/bin/env bash
set -euo pipefail
export TZ=UTC LC_ALL=C

fail() {
	printf 'build-release: %s\n' "$*" >&2
	exit 1
}

project_root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
slug='{{RAN_PACKAGE_SLUG}}'
package_type='{{RAN_PACKAGE_TYPE}}'
header_file='{{RAN_HEADER_PATH}}'
release_ref=${1:-}
expected_version=${2:-}
output_dir=${3:-"$project_root/.ran-booster-release-dist"}

[[ "$package_type" == plugin || "$package_type" == theme ]] || fail 'package type is invalid.'
[[ "$header_file" =~ ^[A-Za-z0-9._-]+$ && "$header_file" != /* && "$header_file" != *'..'* ]] \
	|| fail 'header path is invalid.'
[[ -n "$release_ref" ]] || fail 'expected an explicit release commit.'
[[ "$expected_version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] \
	|| fail 'expected version must be an exact release version.'

[[ "$slug" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ && "${#slug}" -le 100 ]] || fail 'package slug is invalid.'
[[ "${#expected_version}" -le 63 && "${#slug}" -le 100 ]] || fail 'identity length exceeds the starter bounds.'
[[ "$release_ref" =~ ^[0-9a-f]{40}$ ]] || fail 'expected an exact source commit.'

commit=$(git -C "$project_root" rev-parse --verify "$release_ref^{commit}") \
	|| fail 'release ref does not resolve to a commit.'
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || fail 'release commit is invalid.'

regular_blob_oid() {
	local file=$1 record metadata listed mode type object extra
	record=$(git -C "$project_root" ls-tree --full-tree "$commit" -- "$file") \
		|| fail "could not inspect committed source: $file"
	[[ -n "$record" && "$record" == *$'\t'* ]] \
		|| fail "committed source is missing: $file"
	metadata=${record%%$'\t'*}
	listed=${record#*$'\t'}
	read -r mode type object extra <<< "$metadata"
	[[ "$listed" == "$file" && -z "${extra:-}" && "$type" == blob \
		&& ( "$mode" == 100644 || "$mode" == 100755 ) \
		&& "$object" =~ ^[0-9a-f]{40,64}$ ]] \
		|| fail "committed source is not one regular blob: $file"
	printf '%s\n' "$object"
}

temporary=$(mktemp -d "${TMPDIR:-/tmp}/${slug}-release.XXXXXX")
trap 'rm -rf "$temporary"' EXIT HUP INT TERM
stage_root="$temporary/stage/$slug"
allowlist="$temporary/release-contents.txt"
projection="$temporary/projection.tsv"
[[ ! -L "$output_dir" ]] || fail 'output directory is symbolic.'
if [[ -e "$output_dir" ]]; then
	[[ -d "$output_dir" && -z "$(find "$output_dir" -mindepth 1 -print -quit)" ]] || fail 'output directory must be empty.'
fi
mkdir -p "$stage_root" "$output_dir"
: > "$projection"

allowlist_oid=$(regular_blob_oid release-contents.txt)
git -C "$project_root" cat-file blob "$allowlist_oid" > "$allowlist"
[[ -s "$allowlist" ]] || fail 'release allowlist is empty.'

declare -A projected=()
previous=''
while IFS= read -r entry || [[ -n "$entry" ]]; do
	[[ "$entry" =~ ^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$ && "$entry" != *'..'* ]] \
		|| fail "release allowlist entry is unsafe: $entry"
	[[ -z "$previous" || "$previous" < "$entry" ]] || fail 'allowlist must contain sorted unique explicit files.'
	previous=$entry
	object=$(regular_blob_oid "$entry")
	projected[$entry]=1
	printf '%s\t%s\n' "$entry" "$object" >> "$projection"
done < "$allowlist"
[[ ${#projected[@]} -gt 0 ]] || fail 'release allowlist is empty.'

header_oid=$(regular_blob_oid "$header_file")
version_oid=$(regular_blob_oid version.txt)
manifest_oid=$(regular_blob_oid .release-please-manifest.json)
[[ -n "${projected[$header_file]+x}" ]] \
	|| fail 'WordPress header is absent from the committed allowlist.'
header_version=$(git -C "$project_root" cat-file blob "$header_oid" \
	| sed -nE 's/^[[:space:]]*(\*)?[[:space:]]*Version:[[:space:]]*([^[:space:]]+).*/\2/p')
version_source=$(git -C "$project_root" cat-file blob "$version_oid" | tr -d '[:space:]')
manifest_version=$(git -C "$project_root" cat-file blob "$manifest_oid" \
	| jq -er 'select(type == "object" and keys == ["."]) | .["."] | select(type == "string")' )
[[ "$header_version" == "$expected_version" ]] \
	|| fail 'WordPress header version does not match the expected version.'
[[ "$version_source" == "$expected_version" && "$manifest_version" == "$expected_version" ]] \
	|| fail 'Release Please version sources do not agree.'

while IFS=$'\t' read -r file object; do
	destination="$stage_root/$file"
	mkdir -p "$(dirname -- "$destination")"
	git -C "$project_root" cat-file blob "$object" > "$destination"
	if head -n 1 "$destination" | grep -Fxq 'version https://git-lfs.github.com/spec/v1'; then
		fail "unresolved LFS pointer: $file"
	fi
done < <(LC_ALL=C sort -t $'\t' -k1,1 "$projection")

find "$temporary/stage" -type d -exec chmod 0755 {} +
find "$temporary/stage" -type f -exec chmod 0644 {} +
find "$temporary/stage" -exec touch -h -t 198001010000 {} +
output_dir=$(CDPATH='' cd -- "$output_dir" && pwd)
archive="$output_dir/$slug-$expected_version.zip"
rm -f "$archive"
(
	cd "$temporary/stage"
	find "$slug" -print | LC_ALL=C sort | zip -Xq "$archive" -@
)

bash "$project_root/scripts/verify-release.sh" "$archive" "$expected_version" "$commit"
printf '%s\n' "$archive"
