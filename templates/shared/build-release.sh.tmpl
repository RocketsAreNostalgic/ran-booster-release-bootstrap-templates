#!/usr/bin/env bash
set -euo pipefail

fail() {
	printf 'build-release: %s\n' "$*" >&2
	exit 1
}

project_root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
slug='{{RAN_PACKAGE_SLUG}}'
package_type='{{RAN_PACKAGE_TYPE}}'
header_file='{{RAN_HEADER_PATH}}'
allowlist="$project_root/release-contents.txt"
ref=${1:-HEAD}
expected_version=${2:-}
output_dir=${3:-"$project_root/.ran-booster-release-dist"}

[[ "$slug" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || fail 'package slug is invalid.'
[[ "$package_type" == plugin || "$package_type" == theme ]] || fail 'package type is invalid.'
[[ "$header_file" =~ ^[A-Za-z0-9._/-]+$ && "$header_file" != /* && "$header_file" != *'..'* ]] \
	|| fail 'header path is invalid.'
[[ "$expected_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] \
	|| fail 'expected version must be an exact release version.'
[[ -f "$allowlist" && ! -L "$allowlist" ]] || fail 'release allowlist is invalid.'

commit=$(git -C "$project_root" rev-parse --verify "$ref^{commit}") \
	|| fail 'release ref does not resolve to a commit.'
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || fail 'release commit is invalid.'
[[ "$(git -C "$project_root" rev-parse HEAD)" == "$commit" ]] \
	|| fail 'working tree is not checked out at the release commit.'

header_version=$(sed -nE 's/^[[:space:]]*(\*|)[[:space:]]*Version:[[:space:]]*([^[:space:]]+).*/\2/p' "$project_root/$header_file")
version_source=$(tr -d '[:space:]' < "$project_root/version.txt")
manifest_version=$(node -e 'const f=require(process.argv[1]); process.stdout.write(f["."] || "")' "$project_root/.release-please-manifest.json")
[[ "$header_version" == "$expected_version" ]] \
	|| fail 'WordPress header version does not match the expected version.'
[[ "$version_source" == "$expected_version" && "$manifest_version" == "$expected_version" ]] \
	|| fail 'Release Please version sources do not agree.'

temporary=$(mktemp -d "${TMPDIR:-/tmp}/${slug}-release.XXXXXX")
trap 'rm -rf "$temporary"' EXIT HUP INT TERM
stage_root="$temporary/$slug"
mkdir -p "$stage_root" "$output_dir"

declare -A seen=()
while IFS= read -r entry || [[ -n "$entry" ]]; do
	[[ -z "$entry" || "$entry" == \#* ]] && continue
	[[ "$entry" =~ ^[A-Za-z0-9._/-]+$ && "$entry" != /* && "$entry" != *'..'* ]] \
		|| fail "release allowlist entry is unsafe: $entry"
	[[ -z "${seen[$entry]+x}" ]] || fail "duplicate release allowlist entry: $entry"
	seen[$entry]=1
	source="$project_root/$entry"
	[[ -e "$source" && ! -L "$source" ]] || fail "release allowlist entry is missing or symbolic: $entry"
	if find "$source" -type l -print -quit | grep -q .; then
		fail "release allowlist entry contains a symbolic link: $entry"
	fi
	mkdir -p "$(dirname -- "$stage_root/$entry")"
	cp -R "$source" "$stage_root/$entry"
done < "$allowlist"
[[ ${#seen[@]} -gt 0 ]] || fail 'release allowlist is empty.'

find "$temporary" -exec touch -h -t 198001010000 {} +
output_dir=$(CDPATH='' cd -- "$output_dir" && pwd)
archive="$output_dir/$slug-$expected_version.zip"
rm -f "$archive"
(
	cd "$temporary"
	find "$slug" -print | LC_ALL=C sort | zip -Xq "$archive" -@
)

bash "$project_root/scripts/verify-release.sh" "$archive" "$expected_version"
printf '%s\n' "$archive"
