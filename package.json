{
  "name": "ran-booster-release-bootstrap-templates",
  "version": "0.3.1",
  "private": true,
  "description": "Immutable template packs for RAN Booster release bootstrap",
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.13.1",
  "volta": {
    "node": "24.21.0"
  },
  "scripts": {
    "build": "bash scripts/build-pack.sh",
    "verify": "bash scripts/verify-pack.sh",
    "test": "node tests/run.mjs && node --test tests/*.test.mjs",
    "check": "pnpm analyze && pnpm test",
    "analyze": "node scripts/analyze-inspector.mjs"
  }
}
